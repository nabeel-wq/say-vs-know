# Copy to .env and fill in. .env is read automatically by every script.
TINKER_API_KEY=
OPENROUTER_API_KEY=

# Hard spending caps (scripts stop before exceeding them). Tinker: $8 main plan + $10 extension.
TINKER_BUDGET=18.0
OPENROUTER_BUDGET=12.0

# Optional model overrides (OpenRouter ids)
# GEN_MODEL=deepseek/deepseek-v4-flash
# MONITOR_MODELS=google/gemini-2.5-flash-lite,openai/gpt-4.1-nano
# JUDGE_MODEL=google/gemini-2.5-flash-lite
